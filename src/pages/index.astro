---
import Base from '../layouts/Base.astro';
---
<Base title="DREAMSTATE® — DROP 001">
<div class="ds-home">
  <section class="ds-cover ds-video-cover">
    <video class="ds-hero-video" autoplay muted loop playsinline preload="metadata" poster="/jeans.svg" aria-hidden="true"><source src="/IMG_5082.mp4" type="video/mp4"/></video>
    <div class="ds-cover-art"><div class="ds-texture"></div><div class="ds-disc disc-a"></div><div class="ds-disc disc-b"></div><div class="ds-jeans-wrap"><img src="/jeans.svg" alt="DS-001 design illustration — final product photography coming soon" /></div></div>
    <div class="ds-cover-info"><span>COLLECTION 001 — 2026</span><h1>DREAMSTATE<sup>®</sup></h1><div class="ds-cover-bottom"><p>DS—001 / RELAXED BOOTCUT DENIM</p><a href="/shop/ds-001">EXPLORE DS—001 <span>↗</span></a></div></div>
  </section>
  <section class="ds-index"><div class="ds-index-top"><span>01 / THE COLLECTION</span><a href="/shop">SHOP ALL ↗</a></div><div class="ds-index-grid"><a href="/shop/ds-001" class="ds-index-image"><span>DS—001 / DESIGN PREVIEW</span><img src="/jeans.svg" alt="Illustration of DS-001 denim"/></a><div class="ds-index-copy"><span>DROP 001</span><h2>DS—001</h2><p>Relaxed bootcut jeans.<br/>Unisex. Coming soon.</p><a href="/shop/ds-001">VIEW THE PIECE ↗</a></div></div></section>
