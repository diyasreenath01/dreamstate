---
import Base from '../layouts/Base.astro';
---
<Base title="DREAMSTATE — ENTER">
  <div class="ds-landing">
    <video class="ds-landing-video ds-hero-video" autoplay muted loop playsinline preload="metadata"><source src="/IMG_5082.mp4" type="video/mp4" /></video><div class="ds-landing-video-shade" aria-hidden="true"></div>
    <main class="ds-landing-center"><div class="ds-landing-panel">
      <a class="ds-landing-logo" href="/shop" aria-label="DREAMSTATE — shop collection"><img src="/DREAMSTATE%20(7).png" alt="DREAMSTATE" /></a>
      <time id="ds-landing-clock" class="ds-landing-clock"></time>
      <nav class="ds-landing-menu" aria-label="Explore DREAMSTATE">
        <a href="/shop">SHOP ALL</a>
        <a href="/archive">ARCHIVE</a>
        <a href="/world">ABOUT US</a>
        <a href="/contact">CONTACT US</a>
      </nav></div>
    </main>
    <div class="ds-landing-bottom"><span>DS / 001</span><a href="/shop">EXPLORE COLLECTION ↗</a><span>INDEPENDENT CLOTHING</span></div>
  </div>
  <style is:global>
    body.storefront:has(.ds-landing){background:#101014!important}
    body.storefront:has(.ds-landing)>.promo-ribbon,body.storefront:has(.ds-landing)>.store-header,body.storefront:has(.ds-landing)>.store-footer{display:none!important}
    body.storefront:has(.ds-landing)>main{min-height:100svh}
    .ds-landing{position:relative;min-height:100svh;background:#101014;color:#f5f5f5;display:flex;align-items:center;justify-content:center;overflow:hidden;isolation:isolate}
    .ds-landing::before{content:"";position:absolute;inset:-20%;z-index:-2;background-color:#101014;background-image:radial-gradient(ellipse 34px 21px at 12% 18%,#020203 95%,transparent 100%),radial-gradient(ellipse 38px 27px at 65% 28%,#020203 95%,transparent 100%),radial-gradient(ellipse 18px 42px at 39% 74%,#020203 95%,transparent 100%),radial-gradient(ellipse 27px 17px at 88% 78%,#020203 95%,transparent 100%),radial-gradient(ellipse 16px 22px at 18% 81%,#020203 95%,transparent 100%);background-size:135px 120px,170px 155px,120px 180px,195px 140px,110px 135px;background-repeat:repeat;transform:rotate(-8deg) scale(1.2)}
    .ds-landing-grain{position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,#ffffff03 0 1px,transparent 1px 4px);opacity:.4}
    .ds-landing-center{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;padding:90px 24px 110px;gap:0}
    .ds-landing-logo{display:block;width:min(40vw,430px);max-width:90%;margin-bottom:28px;transition:transform .3s ease,filter .3s ease}
    .ds-landing-logo:hover{filter:drop-shadow(0 0 16px #19dfff55)}
    .ds-landing-logo img{display:block;width:100%;height:auto;object-fit:contain}
    .ds-landing-clock{font:500 10px/1.5 monospace;letter-spacing:.09em;color:#fff;margin-bottom:44px}
    .ds-landing-menu{display:flex;flex-direction:column;align-items:center;gap:18px}
    .ds-landing-menu a{font:600 12px/1.2 "Helvetica Neue",Arial,sans-serif;letter-spacing:.065em;color:#fff;text-decoration:none;transition:color .2s,transform .2s}
    .ds-landing-menu a:hover{color:#4cecff;transform:scale(1.07)}
    .ds-landing-bottom{position:absolute;bottom:26px;left:5%;right:5%;display:flex;align-items:center;justify-content:space-between;gap:12px;font:500 9px/1.3 monospace;letter-spacing:.13em;color:#a6a6ac}
    .ds-landing-bottom a{color:#fff}
    @media(max-width:650px){.ds-landing-logo{width:min(75vw,350px);margin-bottom:24px}.ds-landing-center{padding:70px 16px 110px}.ds-landing-clock{margin-bottom:38px}.ds-landing-menu{gap:22px}.ds-landing-bottom{font-size:8px}.ds-landing-bottom span:last-child{display:none}}

    /* Full-screen film with a single black navigation panel */
    .ds-landing{background:#050505!important}
    .ds-landing::before{display:none!important}
    .ds-landing-video{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;object-fit:cover!important;z-index:0!important;display:block!important;opacity:1!important;visibility:visible!important;pointer-events:none!important}
    .ds-landing-video-shade{position:absolute;inset:0;background:#0005;z-index:1;pointer-events:none}
    .ds-landing-center{padding:65px 20px 95px!important}
    .ds-landing-panel{display:flex;flex-direction:column;align-items:center;width:min(86vw,335px);padding:26px 18px 29px;background:rgba(5,5,5,.74);border:1px solid #ffffff35;box-shadow:0 24px 70px #0008}
    .ds-landing-logo{width:min(100%,280px)!important;margin-bottom:13px!important;animation:ds-home-logo-spin 1.6s linear infinite!important;transform-style:preserve-3d;will-change:transform}
    .ds-landing-clock{margin-bottom:23px!important}
    .ds-landing-menu{gap:13px!important}
    .ds-landing-bottom{z-index:3!important}
    @keyframes ds-home-logo-spin{from{transform:rotateY(0deg)}to{transform:rotateY(360deg)}}\n    @media(prefers-reduced-motion:reduce){.ds-landing-logo{animation:none!important}}
    @media(max-width:650px){.ds-landing-panel{width:min(84vw,310px);padding:24px 16px 27px}.ds-landing-logo{width:min(100%,300px)!important}}
  </style>
  <script is:inline>
    (function(){var clock=document.getElementById('ds-landing-clock');if(!clock)return;function tick(){clock.textContent=new Intl.DateTimeFormat('en-US',{month:'2-digit',day:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:true}).format(new Date())}tick();setInterval(tick,30000)})();
  </script>
</Base>