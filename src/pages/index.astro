---
import Base from '../layouts/Base.astro';
---
<Base title="DREAMSTATE — DROP 001"><div class="store-home">
<style is:global>
.ds-radio{background:#101010!important;color:#f4f4f4!important;padding:48px 5% 90px!important;overflow:hidden}
.ds-radio-top{display:flex;justify-content:space-between;gap:16px;border-bottom:1px solid #484848;padding-bottom:16px;font-size:10px;letter-spacing:.18em}
.ds-radio-main{display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,.65fr);gap:7%;align-items:center;padding:60px 4%}
.ds-radio-art{display:flex;align-items:center;justify-content:center}
.ds-record{width:min(38vw,460px);aspect-ratio:1;border-radius:50%;background:repeating-radial-gradient(circle at center,#171717 0,#171717 2px,#292929 3px,#151515 4px,#111 6px);box-shadow:0 0 0 2px #333,0 30px 75px #000a,inset -20px -14px 50px #0009;display:flex;align-items:center;justify-content:center;animation:ds-vinyl-spin 9s linear infinite;position:relative}
.ds-record:before{content:'';position:absolute;inset:9%;border:1px solid #555;border-radius:50%}
.ds-record-label{height:35%;width:35%;border-radius:50%;background:#e8e8e8;color:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;font-family:'Space Grotesk',sans-serif;letter-spacing:-.04em;font-size:clamp(10px,1.6vw,20px);font-weight:700}
.ds-record-label small{font-size:clamp(5px,.65vw,9px);letter-spacing:.12em;font-weight:500}
.ds-record-label i{width:9px;height:9px;background:#111;border-radius:50%}
@keyframes ds-vinyl-spin{to{transform:rotate(360deg)}}
.ds-radio-deck{display:flex;flex-direction:column;align-items:flex-start;gap:14px}
.ds-radio-deck>span{font-size:11px;color:#999;letter-spacing:.16em}
.ds-radio-deck strong{font:600 clamp(34px,5vw,78px)/.95 'Space Grotesk',sans-serif;letter-spacing:-.065em;overflow-wrap:anywhere}
.ds-radio-deck small{font-size:12px;letter-spacing:.13em;color:#aaa}
.ds-radio-indicator{font-size:10px;letter-spacing:.12em;color:#999;margin-top:20px}
.ds-radio-led{display:inline-block;width:7px;height:7px;border-radius:50%;background:#e9e9e9;margin-right:7px}
.ds-radio-tracks{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(200px,.65fr);gap:8%;border-top:1px solid #484848;padding-top:24px}
.ds-radio-tracklist{display:flex;flex-direction:column}
.ds-radio .ds-track{display:grid;grid-template-columns:35px minmax(0,1fr) 145px 20px;align-items:center;gap:10px;width:100%;background:transparent;color:#bdbdbd;text-align:left;border:0;border-bottom:1px solid #353535;padding:21px 12px;cursor:pointer;transition:background .2s,color .2s}
.ds-track>span{font-size:10px;letter-spacing:.09em}
.ds-track strong{font-size:clamp(12px,1.35vw,17px);letter-spacing:-.02em}
.ds-radio .ds-track:hover,.ds-radio .ds-track.active{background:#f1f1f1;color:#0c0c0c}
.ds-radio-side{display:flex;flex-direction:column;align-items:flex-start;gap:22px;padding-top:25px}
.ds-radio-side>span{font:600 clamp(29px,3.5vw,55px)/1 'Space Grotesk',sans-serif;letter-spacing:-.06em}
.ds-radio-side p{font-size:13px;line-height:1.8;color:#aaa;max-width:280px}
.ds-radio-side a{padding:16px 20px;background:#f4f4f4;color:#111;font-size:11px;letter-spacing:.08em;font-weight:700}
.ds-radio-side small{font-size:9px;letter-spacing:.12em;color:#777}
@media(prefers-reduced-motion:reduce){.ds-record{animation:none}}
@media(max-width:700px){.ds-radio{padding:34px 5% 60px!important}.ds-radio-top{font-size:8px}.ds-radio-main{grid-template-columns:1fr;gap:35px;padding:48px 0}.ds-record{width:min(75vw,340px)}.ds-radio-deck strong{font-size:44px}.ds-radio-tracks{grid-template-columns:1fr;gap:25px}.ds-radio .ds-track{grid-template-columns:23px minmax(0,1fr) 70px 12px;gap:5px;padding:17px 5px}.ds-track strong{font-size:12px}.ds-track>span{font-size:8px}.ds-radio-side{padding-top:5px}}

.ds-radio{background:radial-gradient(ellipse at 23% 20%,#252525 0%,#101010 47%,#080808 100%)!important}
.ds-turntable{width:min(100%,540px);aspect-ratio:1.16;position:relative;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#383838 0%,#1a1a1a 35%,#0b0b0b 85%);border:1px solid #535353;border-radius:12px;box-shadow:inset 0 0 0 5px #141414,inset 0 0 0 6px #3a3a3a,0 28px 48px #000b;isolation:isolate}
.ds-turntable:before{content:'';position:absolute;inset:12px;border:1px solid #ffffff16;border-radius:5px}
.ds-turntable-stamp{position:absolute;top:6%;left:6%;font:600 9px 'Space Grotesk',sans-serif;letter-spacing:.18em;color:#999;z-index:4}
.ds-turntable-stamp span{display:block;font-size:8px;color:#666;margin-top:5px}
.ds-turntable-platter{position:absolute;width:75%;aspect-ratio:1;left:5.5%;top:12.5%;border-radius:50%;background:repeating-linear-gradient(0deg,#555 0px,#111 2px,#666 3px,#222 5px);box-shadow:0 0 0 4px #090909,0 0 0 6px #494949,0 13px 20px #000a;display:grid;place-items:center}
.ds-turntable .ds-record{width:97%!important;max-width:none!important;aspect-ratio:1;background:radial-gradient(circle at 35% 25%,#ffffff12 0%,transparent 35%),repeating-radial-gradient(circle at center,#101010 0px,#101010 1px,#2d2d2d 1.6px,#0b0b0b 2.8px,#171717 4px)!important;box-shadow:inset 0 0 35px #0008,0 0 0 1px #333!important}
.ds-turntable .ds-record:after{content:'';position:absolute;inset:18%;border-radius:50%;background:conic-gradient(from 25deg,transparent 0deg,#ffffff0d 19deg,transparent 42deg,transparent 180deg,#ffffff0b 206deg,transparent 234deg)}
.ds-turntable .ds-record-label{width:33%;height:33%;background:#d4d1c9;border:1px solid #aaa;box-shadow:0 0 0 2px #1a1a1a;font-size:clamp(9px,1.2vw,15px);gap:5px;z-index:1}
.ds-tonearm{position:absolute;z-index:5;inset:0;pointer-events:none;filter:drop-shadow(3px 7px 3px #000b)}
.ds-tonearm-pivot{position:absolute;right:9%;top:16%;width:13%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 38% 33%,#b5b5b5 0%,#555 24%,#141414 27%,#333 60%,#070707 66%);border:2px solid #666;box-shadow:0 0 0 4px #121212}
.ds-tonearm-shaft{position:absolute;right:14%;top:21%;height:48%;width:2.2%;border-radius:10px;background:linear-gradient(90deg,#666,#eee 38%,#555 75%,#1d1d1d);transform-origin:50% 0;transform:rotate(20deg);box-shadow:2px 0 2px #000a}
.ds-tonearm-head{position:absolute;right:29%;top:64%;width:7%;height:4%;background:linear-gradient(145deg,#aaa,#444 55%,#161616);border:1px solid #777;border-radius:2px;transform:rotate(20deg);box-shadow:0 4px 5px #0009}
.ds-turntable-controls{position:absolute;bottom:5%;left:7%;right:7%;display:flex;align-items:center;gap:16px;color:#888;font-size:9px;letter-spacing:.14em}
.ds-turntable-power{height:10px;width:10px;border-radius:50%;background:#dfded8;box-shadow:0 0 9px #ffffff6b}
.ds-turntable-status{margin-left:auto;color:#ccc}
.ds-record-changed{animation-duration:6s!important}
@media(max-width:700px){.ds-turntable{width:min(90vw,420px)}.ds-turntable-stamp{font-size:7px}.ds-turntable-controls{font-size:7px;gap:10px}}
@media(prefers-reduced-motion:reduce){.ds-turntable .ds-record{animation:none!important}}

/* Radio layout correction: two-column feature, two-column track area */
.ds-radio{box-sizing:border-box!important;width:100%!important}
.ds-radio *, .ds-radio *:before,.ds-radio *:after{box-sizing:border-box}
.ds-radio .ds-radio-main{display:block!important;padding:54px 0 62px!important}
.ds-radio .ds-radio-art{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,.9fr)!important;gap:clamp(35px,6vw,100px)!important;align-items:center!important;justify-content:initial!important;width:100%!important}
.ds-radio .ds-turntable{width:100%!important;max-width:540px!important;margin:0 auto!important}
.ds-radio .ds-radio-deck{min-width:0!important;width:100%!important;padding:0!important}
.ds-radio .ds-radio-deck strong{display:block!important;max-width:100%!important;font-size:clamp(36px,5vw,74px)!important;line-height:1.04!important;overflow-wrap:break-word!important;word-break:normal!important}
.ds-radio .ds-radio-tracks{display:grid!important;grid-template-columns:minmax(0,1.65fr) minmax(240px,.8fr)!important;gap:clamp(35px,5vw,85px)!important;align-items:start!important}
.ds-radio .ds-radio-tracklist{display:flex!important;flex-direction:column!important;min-width:0!important;width:100%!important}
.ds-radio .ds-track{display:grid!important;grid-template-columns:35px minmax(0,1fr) 125px 20px!important;gap:14px!important;align-items:center!important;min-width:0!important;width:100%!important;min-height:69px!important;padding:15px 14px!important;white-space:normal!important}
.ds-radio .ds-track strong{display:block!important;font-size:clamp(13px,1.2vw,17px)!important;line-height:1.35!important;min-width:0!important;overflow-wrap:break-word!important}
.ds-radio .ds-track span{display:block!important;min-width:0!important;line-height:1.4!important}
.ds-radio .ds-track span:nth-of-type(2){font-size:10px!important;overflow-wrap:break-word!important}
.ds-radio .ds-radio-side{min-width:0!important;max-width:360px!important}
.ds-radio .ds-radio-side>span{font-size:clamp(30px,3vw,48px)!important;line-height:1.06!important;overflow-wrap:normal!important}
@media(max-width:900px){
.ds-radio .ds-radio-art{gap:30px!important}
.ds-radio .ds-radio-tracks{grid-template-columns:minmax(0,1fr)!important;gap:24px!important}
.ds-radio .ds-radio-side{max-width:none!important;display:grid!important;grid-template-columns:1fr 1fr!important;align-items:start!important}
.ds-radio .ds-radio-side>span{grid-row:span 3}
}
@media(max-width:650px){
.ds-radio .ds-radio-main{padding:34px 0 42px!important}
.ds-radio .ds-radio-art{grid-template-columns:minmax(0,1fr)!important;gap:32px!important}
.ds-radio .ds-turntable{width:min(100%,390px)!important}
.ds-radio .ds-radio-deck strong{font-size:clamp(34px,10vw,54px)!important}
.ds-radio .ds-radio-side{display:flex!important;flex-direction:column!important}
.ds-radio .ds-track{grid-template-columns:25px minmax(0,1fr) 75px 14px!important;gap:8px!important;padding:14px 6px!important;min-height:64px!important}
.ds-radio .ds-track strong{font-size:12px!important}
.ds-radio .ds-track span:nth-of-type(2){font-size:8px!important}
}

.ds-radio .ds-soundcloud{width:100%;max-width:360px;display:flex;flex-direction:column;gap:14px;border-top:1px solid #555;padding-top:20px}
.ds-radio .ds-soundcloud-heading{display:flex;justify-content:space-between;gap:10px;font-size:9px;letter-spacing:.08em;color:#999}
.ds-radio .ds-sc-player{background:#1b1b1b;border:1px solid #383838;min-height:110px;padding:15px;display:flex;align-items:center;width:100%}
.ds-radio .ds-sc-player p{font-size:11px;color:#aaa;line-height:1.7;margin:0}
.ds-radio .ds-sc-player iframe{width:100%;height:166px;border:0;background:#111}
.ds-radio .ds-soundcloud>a{display:block;text-align:center;padding:15px 12px;font-size:10px;letter-spacing:.08em;background:#eee;color:#111;font-weight:700}

/* DREAMSTATE Radio: restrained compact editorial layout */
.ds-radio{padding:30px 5% 54px!important}
.ds-radio .ds-radio-top{font-size:9px!important;padding-bottom:13px!important}
.ds-radio .ds-radio-main{padding:34px 0 38px!important}
.ds-radio .ds-radio-art{grid-template-columns:minmax(0,390px) minmax(0,1fr)!important;gap:clamp(28px,5vw,72px)!important;max-width:1060px!important;margin:0 auto!important}
.ds-radio .ds-turntable{max-width:365px!important;border-radius:7px!important;box-shadow:inset 0 0 0 4px #141414,0 16px 30px #0008!important}
.ds-radio .ds-radio-deck{gap:9px!important}
.ds-radio .ds-radio-deck>span{font-size:9px!important}
.ds-radio .ds-radio-deck strong{font-size:clamp(28px,3.5vw,50px)!important;line-height:1.04!important;letter-spacing:-.04em!important}
.ds-radio .ds-radio-deck small{font-size:10px!important}
.ds-radio .ds-radio-indicator{font-size:9px!important;margin-top:12px!important}
.ds-radio .ds-radio-tracks{grid-template-columns:minmax(0,1.55fr) minmax(0,.75fr)!important;gap:clamp(28px,5vw,70px)!important;max-width:1100px!important;margin:0 auto!important}
.ds-radio .ds-track{grid-template-columns:27px minmax(0,1fr) 112px 14px!important;min-height:49px!important;padding:11px 10px!important;gap:10px!important}
.ds-radio .ds-track strong{font-size:12px!important;font-weight:600!important;line-height:1.3!important}
.ds-radio .ds-track span:nth-of-type(2){font-size:9px!important}
.ds-radio .ds-radio-side{gap:13px!important;padding-top:8px!important;max-width:300px!important}
.ds-radio .ds-radio-side>span{font-size:clamp(25px,2.7vw,37px)!important;line-height:1.04!important}
.ds-radio .ds-radio-side p{font-size:11px!important;line-height:1.6!important}
.ds-radio .ds-soundcloud{gap:10px!important;padding-top:13px!important}
.ds-radio .ds-sc-player{min-height:65px!important;padding:11px!important}
.ds-radio .ds-sc-player p{font-size:10px!important}
.ds-radio .ds-soundcloud>a{padding:11px 12px!important;font-size:9px!important}
@media(max-width:900px){.ds-radio .ds-radio-tracks{grid-template-columns:minmax(0,1fr)!important}.ds-radio .ds-radio-side{max-width:none!important}}
@media(max-width:650px){.ds-radio{padding:24px 5% 42px!important}.ds-radio .ds-radio-main{padding:28px 0!important}.ds-radio .ds-radio-art{grid-template-columns:minmax(0,1fr)!important;gap:25px!important}.ds-radio .ds-turntable{max-width:285px!important}.ds-radio .ds-radio-deck strong{font-size:34px!important}.ds-radio .ds-radio-tracks{grid-template-columns:minmax(0,1fr)!important;gap:20px!important}.ds-radio .ds-track{grid-template-columns:22px minmax(0,1fr) 70px 12px!important;padding:11px 5px!important;gap:6px!important}.ds-radio .ds-track strong{font-size:11px!important}.ds-radio .ds-radio-side{display:flex!important;flex-direction:column!important}.ds-radio .ds-radio-side>span{font-size:28px!important}}
</style>
