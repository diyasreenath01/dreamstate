---
const { title = 'DREAMSTATE', description = 'DREAMSTATE independent clothing. Explore DS-001 denim.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#22254b"/><meta name="description" content={description}/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/><link rel="stylesheet" href="/style.css?v=20261114-introfix005"/><style is:global>
#ds-intro{position:fixed!important;inset:0!important;z-index:99999!important;display:grid!important;place-items:center!important;overflow:hidden!important;background:#22254b!important;color:white!important;isolation:isolate;transition:opacity .8s ease,visibility .8s ease}
#ds-intro.is-exiting{opacity:0!important;visibility:hidden!important;pointer-events:none!important}
#ds-intro .ds-intro-orbit{position:absolute!important;width:min(72vw,72vh,680px)!important;aspect-ratio:1!important;animation:ds-orbit 13s linear infinite!important}
#ds-intro .ds-intro-ring{position:absolute!important;inset:0!important;border:1px solid #ffffff85!important;border-radius:50%!important;display:block!important}
#ds-intro .ds-intro-ring-one{transform:rotateX(65deg) rotateY(-22deg)}
#ds-intro .ds-intro-ring-two{transform:rotateY(65deg) rotateZ(45deg)}
#ds-intro .ds-intro-ring-three{inset:12%!important;transform:rotateX(45deg) rotateZ(-35deg)}
#ds-intro .ds-intro-center{z-index:2!important;display:flex!important;flex-direction:column!important;align-items:center!important;gap:18px!important;text-align:center!important}
#ds-intro .ds-intro-word{font:600 clamp(32px,7vw,105px)/1 Arial,sans-serif!important;letter-spacing:-.08em!important;white-space:nowrap!important}
#ds-intro .ds-intro-small{font:500 10px Arial,sans-serif!important;letter-spacing:.26em!important}
#ds-intro .ds-intro-enter{position:absolute!important;bottom:10%!important;left:50%!important;transform:translateX(-50%)!important;background:transparent!important;color:white!important;border:1px solid #fff!important;padding:17px 25px!important;font:500 11px Arial,sans-serif!important;letter-spacing:.14em!important;z-index:3!important;cursor:pointer!important}
#ds-intro .ds-intro-counter{position:absolute!important;bottom:5%!important;left:5%!important;font:10px Arial,sans-serif!important;letter-spacing:.15em!important}
@keyframes ds-orbit{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){#ds-intro .ds-intro-orbit{animation:none!important}}
</style></head><body class="storefront"><div id="ds-intro" style="display:none" class="ds-intro" aria-label="DREAMSTATE introduction"><div class="ds-intro-orbit" aria-hidden="true"><span class="ds-intro-ring ds-intro-ring-one"></span><span class="ds-intro-ring ds-intro-ring-two"></span><span class="ds-intro-ring ds-intro-ring-three"></span></div><div class="ds-intro-center"><span class="ds-intro-small">INDEPENDENT CLOTHING</span><span class="ds-intro-word">DREAMSTATE</span><span class="ds-intro-small">ENTER THE WORLD</span></div><button id="ds-intro-enter" class="ds-intro-enter" type="button">ENTER SITE <span>↗</span></button><span class="ds-intro-counter">DS / 001</span></div>
<div class="promo-ribbon">SIGN UP TO GET 15% OFF YOUR FIRST ORDER <span>— OFFER AVAILABLE WHEN CHECKOUT LAUNCHES</span></div>
<header class="store-header"><div class="store-header-left"><form class="store-search" action="/shop" method="get" role="search"><input type="search" name="q" id="store-search-input" placeholder="SEARCH" aria-label="Search products"/><button type="submit" aria-label="Search">⌕</button></form><button class="store-menu" id="menu-toggle" aria-label="Toggle navigation">☰</button><nav id="nav-links"><a href="/shop">SHOP</a><a href="/archive">ARCHIVE</a><a href="/world">ABOUT</a></nav></div><a class="store-logo" href="/" aria-label="DREAMSTATE home"><img src="/DREAMSTATE%20(6).png" alt="DREAMSTATE" /></a><div class="store-actions"><button id="cart-trigger" aria-label="Open shopping bag">BAG <span id="cart-count">(0)</span></button><label class="sr-only" for="store-language">Language</label><select id="store-language" aria-label="Language"><option value="en">EN</option></select><label class="sr-only" for="store-currency">Currency</label><select id="store-currency" aria-label="Currency"><option value="AED">AED</option><option value="USD">USD</option><option value="GBP">GBP</option><option value="EUR">EUR</option></select></div></header>
<script is:inline>
(function(){var el=document.getElementById('ds-intro');if(!el)return;var seen=false;try{seen=sessionStorage.getItem('ds-intro-seen')==='1'}catch(e){}if(location.pathname!=='/'||location.hash||seen||matchMedia('(prefers-reduced-motion: reduce)').matches){el.remove();return}el.style.display='grid';document.body.style.overflow='hidden';var done=false;function close(){if(done)return;done=true;try{sessionStorage.setItem('ds-intro-seen','1')}catch(e){}el.classList.add('is-exiting');document.body.style.overflow='';setTimeout(function(){el.remove()},850)}el.querySelector('#ds-intro-enter').addEventListener('click',close);setTimeout(close,4200)})();
</script><main><slot/></main>
<footer class="store-footer"><div class="store-footer-grid"><div><h2>DREAMSTATE</h2><p>INDEPENDENT CLOTHING / DROP 001</p><a href="/world">OUR STORY</a></div><div><h3>HELP</h3><a href="/faq">FAQ</a><a href="/terms">TERMS OF SERVICE</a><a href="/contact">CONTACT US</a></div><div><h3>CONTACT</h3><p>Contact details will be published before launch.</p><a href="/contact">CONTACT US ↗</a></div><div><h3>EMAIL UPDATES</h3><p>Be first to know about the launch.</p><form id="signup-form"><input id="signup-email" type="email" required placeholder="Email address" aria-label="Email address"/><button type="submit">JOIN ↗</button></form><div id="signup-message" role="status"></div><small>Signup not yet connected.</small></div></div><div class="store-footer-bottom"><span>© {new Date().getFullYear()} DREAMSTATE</span><span>DROP 001</span></div></footer>
<dialog id="bag-dialog"><div class="bag-head"><strong>YOUR BAG</strong><button id="bag-close" aria-label="Close bag">✕</button></div><div id="bag-items"></div><div class="bag-bottom"><p>Preview bag only. Orders and checkout are not available yet.</p><a href="/shop" class="btn primary" id="bag-signup">CONTINUE BROWSING ↗</a></div></dialog><script is:inline src="/site.js?v=20261114-introfix005"></script></body></html>