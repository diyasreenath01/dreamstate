---
const { title = 'DREAMSTATE', description = 'DREAMSTATE independent clothing. Explore DS-001 denim.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#050505"/><meta name="description" content={description}/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/><link rel="stylesheet" href="/style.css?v=20261114-black007"/><link rel="stylesheet" href="/dream-experience.css?v=1"/><style is:global>
#ds-intro{position:fixed!important;inset:0!important;z-index:99999!important;display:grid!important;place-items:center!important;overflow:hidden!important;background:#050505!important;color:white!important;isolation:isolate;transition:opacity .8s ease,visibility .8s ease}
#ds-intro.is-exiting{opacity:0!important;visibility:hidden!important;pointer-events:none!important}
#ds-intro .ds-intro-orbit{position:absolute!important;width:min(72vw,72vh,680px)!important;aspect-ratio:1!important;animation:ds-orbit 13s linear infinite!important}
#ds-intro .ds-intro-ring{position:absolute!important;inset:0!important;border:1px solid #ffffff85!important;border-radius:50%!important;display:block!important}
#ds-intro .ds-intro-ring-one{transform:rotateX(65deg) rotateY(-22deg)}
#ds-intro .ds-intro-ring-two{transform:rotateY(65deg) rotateZ(45deg)}
#ds-intro .ds-intro-ring-three{inset:12%!important;transform:rotateX(45deg) rotateZ(-35deg)}
#ds-intro .ds-intro-center{z-index:2!important;display:flex!important;flex-direction:column!important;align-items:center!important;gap:18px!important;text-align:center!important}
#ds-intro .ds-intro-word{font:600 clamp(32px,7vw,105px)/1 Arial,sans-serif!important;letter-spacing:-.08em!important;white-space:nowrap!important}
#ds-intro .ds-intro-small{font:500 10px Arial,sans-serif!important;letter-spacing:.26em!important}
#ds-intro .ds-intro-enter{position:absolute!important;bottom:10%!important;left:50%!important;transform:translateX(-50%)!important;background:transparent!important;color:white!important;border:1px solid #fff!important;padding:17px 25px!important;font:500 11px Arial,sans-serif!important;letter-spacing:.14em!important;z-index:3!important;cursor:pointer!important}
#ds-intro .ds-intro-counter{position:absolute!important;bottom:5%!important;left:5%!important;font:10px Arial,sans-serif!important;letter-spacing:.15em!important}
@keyframes ds-orbit{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){#ds-intro .ds-intro-orbit{animation:none!important}}
</style><style is:global>
#ds-intro{background:#050505!important}
#ds-intro::before,#ds-intro::after{content:none!important;display:none!important}
#ds-intro .ds-intro-logo-wrap{position:relative!important;width:min(54vw,510px)!important;display:grid!important;place-items:center!important;perspective:1000px!important;animation:ds-logo-spin 1.35s linear infinite!important}
#ds-intro .ds-intro-logo{display:block!important;width:100%!important;height:auto!important;object-fit:contain!important;mix-blend-mode:screen!important;filter:drop-shadow(0 0 8px #00dfff55)!important}
#ds-intro .ds-intro-enter{bottom:8%!important}
@keyframes ds-logo-spin{0%{transform:rotateY(0deg)}100%{transform:rotateY(360deg)}}
@media(max-width:650px){#ds-intro .ds-intro-logo-wrap{width:min(86vw,390px)!important}}
@media(prefers-reduced-motion:reduce){#ds-intro .ds-intro-logo-wrap{animation:none!important}}
</style><style is:global>
#ds-page-transition{position:fixed;inset:0;z-index:99998;display:grid;place-items:center;background:#050505;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .18s ease,visibility .18s ease}
#ds-page-transition.is-visible{opacity:1;visibility:visible;pointer-events:all}
#ds-page-transition img{mix-blend-mode:screen;width:min(44vw,370px);height:auto;object-fit:contain;animation:ds-logo-spin .85s linear infinite;filter:drop-shadow(0 0 6px #00dfff55)}
@media(max-width:650px){#ds-page-transition img{width:min(76vw,300px)}}
@media(prefers-reduced-motion:reduce){#ds-page-transition img{animation:none}}
</style><style is:global>
#ds-sound-toggle{position:fixed;right:20px;bottom:19px;z-index:9997;padding:10px 13px;background:#050505d9;color:#fff;border:1px solid #ffffff50;border-radius:0;font:600 10px/1 "Helvetica Neue",Arial,sans-serif;letter-spacing:.13em;cursor:pointer;min-width:110px;backdrop-filter:blur(7px)}
#ds-sound-toggle:hover{background:#050505}
@media(max-width:650px){#ds-sound-toggle{right:12px;bottom:12px;padding:11px;font-size:9px}}
</style><script is:inline>
/* Remove the opaque black background from DREAMSTATE (7) using the source pixels.
   Applies to the intro, page transition and homepage, with a transparent PNG output. */
(function(){
 var path='/DREAMSTATE%20(7).png';
 function apply(){
  var imgs=document.querySelectorAll('.ds-intro-logo, #ds-page-transition img, .ds-landing-logo img');
  if(!imgs.length)return;
  imgs.forEach(function(img){img.style.visibility='hidden'});
  var source=new Image();
  source.onload=function(){
   try{
    var canvas=document.createElement('canvas');canvas.width=source.naturalWidth;canvas.height=source.naturalHeight;
    var context=canvas.getContext('2d',{willReadFrequently:true});
    context.drawImage(source,0,0);
    var pixels=context.getImageData(0,0,canvas.width,canvas.height),d=pixels.data;
    for(var i=0;i<d.length;i+=4){
     var light=Math.max(d[i],d[i+1],d[i+2]);
     // Extract white spray paint as alpha; preserves soft overspray and fine particles.
     var alpha=light<12?0:Math.min(255,Math.round((light-12)*255/230));
     d[i]=255;d[i+1]=255;d[i+2]=255;d[i+3]=Math.round(d[i+3]*alpha/255);
    }
    context.putImageData(pixels,0,0);
    // Crop away the source image's enormous empty margins so the logo fills its frame.
    var left=canvas.width,top=canvas.height,right=0,bottom=0;
    for(var y=0;y<canvas.height;y++)for(var x=0;x<canvas.width;x++){
     if(d[(y*canvas.width+x)*4+3]>18){if(x<left)left=x;if(x>right)right=x;if(y<top)top=y;if(y>bottom)bottom=y}
    }
    var margin=Math.max(8,Math.round(canvas.width*.025));
    left=Math.max(0,left-margin);top=Math.max(0,top-margin);
    right=Math.min(canvas.width-1,right+margin);bottom=Math.min(canvas.height-1,bottom+margin);
    var cropped=document.createElement('canvas');
    cropped.width=right-left+1;cropped.height=bottom-top+1;
    cropped.getContext('2d').drawImage(canvas,left,top,cropped.width,cropped.height,0,0,cropped.width,cropped.height);
    var transparent=cropped.toDataURL('image/png');
    imgs.forEach(function(img){img.src=transparent;img.style.mixBlendMode='normal';img.style.visibility='visible'});
   }catch(e){console.warn('DREAMSTATE logo processing:',e)}
  };
  source.onerror=function(){imgs.forEach(function(img){img.style.visibility='visible';img.style.mixBlendMode='screen'})};
  source.src=path;
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',apply,{once:true});else apply();
})();
</script></head><body class="storefront"><div id="ds-intro" style="display:none" class="ds-intro" aria-label="DREAMSTATE introduction"><div class="ds-intro-logo-wrap"><img class="ds-intro-logo" src="/DREAMSTATE%20(7).png" alt="DREAMSTATE" /></div><button id="ds-intro-enter" class="ds-intro-enter" type="button">ENTER SITE ↗</button></div>
<div id="ds-page-transition" aria-hidden="true"><img src="/DREAMSTATE%20(7).png" alt="" /></div>
<button id="ds-sound-toggle" type="button" aria-label="Toggle background music" aria-pressed="false">◗ SOUND OFF</button><script src="/ds-music.js?v=3" defer></script>
<div class="promo-ribbon">SIGN UP TO GET 15% OFF YOUR FIRST ORDER <span>— OFFER AVAILABLE WHEN CHECKOUT LAUNCHES</span></div>
<header class="store-header"><div class="store-header-left"><form class="store-search" action="/shop" method="get" role="search"><input type="search" name="q" id="store-search-input" placeholder="SEARCH" aria-label="Search products"/><button type="submit" aria-label="Search">⌕</button></form><button class="store-menu" id="menu-toggle" aria-label="Toggle navigation">☰</button><nav id="nav-links"><a href="/shop">SHOP</a><a href="/archive">ARCHIVE</a><a href="/world">ABOUT</a></nav></div><a class="store-logo" href="/" aria-label="DREAMSTATE home"><img src="/DREAMSTATE%20(6).png" alt="DREAMSTATE" /></a><div class="store-actions"><button id="cart-trigger" aria-label="Open shopping bag">BAG <span id="cart-count">(0)</span></button><label class="sr-only" for="store-language">Language</label><select id="store-language" aria-label="Language"><option value="en">EN</option></select><label class="sr-only" for="store-currency">Currency</label><select id="store-currency" aria-label="Currency"><option value="AED">AED</option><option value="USD">USD</option><option value="GBP">GBP</option><option value="EUR">EUR</option></select></div></header>
<script is:inline>
(function(){var el=document.getElementById('ds-intro');if(!el)return;if(location.pathname!=='/'||location.hash||matchMedia('(prefers-reduced-motion: reduce)').matches){el.remove();return}el.style.display='grid';document.body.style.overflow='hidden';var done=false;function close(){if(done)return;done=true;el.classList.add('is-exiting');document.body.style.overflow='';setTimeout(function(){el.remove()},850)}el.querySelector('#ds-intro-enter').addEventListener('click',close);setTimeout(close,4200)})();
</script><script is:inline>
(function(){
 var overlay=document.getElementById('ds-page-transition');if(!overlay)return;
 var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
 /* The transition runs only before navigation; never replay it on arrival. */
 document.addEventListener('click',function(e){
  if(e.defaultPrevented||e.button!==0||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;
  var link=e.target.closest('a[href]');if(!link||link.target&&link.target!=='_self'||link.hasAttribute('download'))return;
  var url;try{url=new URL(link.href,location.href)}catch(err){return}
  if(url.origin!==location.origin||url.pathname===location.pathname&&url.search===location.search)return;
  e.preventDefault();overlay.classList.add('is-visible');
  
  setTimeout(function(){location.assign(url.href)},reduce?120:420);
 });
 window.addEventListener('pageshow',function(e){if(e.persisted)overlay.classList.remove('is-visible')});
})();
</script><main><slot/></main>
<footer class="store-footer"><div class="store-footer-grid"><div><h2>DREAMSTATE</h2><p>INDEPENDENT CLOTHING / DROP 001</p><a href="/world">OUR STORY</a></div><div><h3>HELP</h3><a href="/faq">FAQ</a><a href="/terms">TERMS OF SERVICE</a><a href="/contact">CONTACT US</a></div><div><h3>CONTACT</h3><p>Contact details will be published before launch.</p><a href="/contact">CONTACT US ↗</a></div><div><h3>EMAIL UPDATES</h3><p>Be first to know about the launch.</p><form id="signup-form"><input id="signup-email" type="email" required placeholder="Email address" aria-label="Email address"/><button type="submit">JOIN ↗</button></form><div id="signup-message" role="status"></div><small>Signup not yet connected.</small></div></div><div class="store-footer-bottom"><span>© {new Date().getFullYear()} DREAMSTATE</span><span>DROP 001</span></div></footer>
<dialog id="bag-dialog"><div class="bag-head"><strong>YOUR BAG</strong><button id="bag-close" aria-label="Close bag">✕</button></div><div id="bag-items"></div><div class="bag-bottom"><p>Preview bag only. Orders and checkout are not available yet.</p><a href="/shop" class="btn primary" id="bag-signup">CONTINUE BROWSING ↗</a></div></dialog><script is:inline src="/site.js?v=20261114-introfix005"></script><script is:inline src="/dream-experience.js?v=1" defer></script></body></html>